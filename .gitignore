# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Secrets and credentials
.env
.env.*
*.pem
*.key

# Terraform (.terraform.lock.hcl is intentionally committed)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
crash.log
# Child modules are not roots: their lock file comes from `terraform init` before `terraform test`
terraform/modules/*/.terraform.lock.hcl
